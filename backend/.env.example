NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Aiven PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME?sslmode=require&schema=public"

# Authentication
JWT_SECRET="replace_with_a_secure_random_secret_of_at_least_32_characters"

# Aiven Kafka
KAFKA_BOOTSTRAP_SERVERS=HOST:PORT
KAFKA_USERNAME=YOUR_KAFKA_USERNAME
KAFKA_PASSWORD_BASE64=BASE64_ENCODED_KAFKA_PASSWORD
KAFKA_CA_PATH=C:/path/to/your/ca.pem
KAFKA_ORDERS_TOPIC=veloce-orders-test